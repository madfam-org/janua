          {
            "in": "header",
            "name": "X-Internal-API-Key",
            "required": true,
            "schema": {
              "title": "X-Internal-Api-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendEmailRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
